{
  "name": "faultier",
  "version": "3.1.2",
  "description": "Extensible error handling for TypeScript",
  "keywords": [
    "error-handling",
    "errors",
    "faults",
    "tagged-errors",
    "typescript"
  ],
  "homepage": "https://github.com/adelrodriguez/faultier#readme",
  "bugs": {
    "url": "https://github.com/adelrodriguez/faultier/issues"
  },
  "license": "MIT",
  "author": "Adel Rodríguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelrodriguez/faultier.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "analyze": "adamantite analyze",
    "build": "tsdown",
    "bump:deps": "pnpm update --interactive",
    "check": "adamantite check",
    "dev": "tsdown --watch",
    "fix": "adamantite fix",
    "release": "changeset publish",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "pnpm run build && node scripts/verify-package.ts",
    "test:watch": "vitest",
    "typecheck": "adamantite check",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "adamantite": "0.41.0",
    "fast-check": "4.10.2",
    "knip": "6.32.2",
    "oxfmt": "0.65.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@11.23.0"
}
