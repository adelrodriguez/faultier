{
  "name": "faultier",
  "version": "3.0.1",
  "description": "Extensible error handling for TypeScript",
  "keywords": [
    "error-handling",
    "errors",
    "faults",
    "tagged-errors",
    "typescript"
  ],
  "homepage": "https://github.com/adelrodriguez/faultier#readme",
  "bugs": {
    "url": "https://github.com/adelrodriguez/faultier/issues"
  },
  "license": "MIT",
  "author": "Adel Rodríguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelrodriguez/faultier.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "analyze": "adamantite analyze",
    "build": "bunup",
    "bump:deps": "bun update --interactive",
    "check": "adamantite check",
    "dev": "bunup --watch",
    "fix": "adamantite fix",
    "format": "adamantite format",
    "release": "changeset publish --use-npmrc .npmrc",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:package": "bun run build && bun scripts/verify-package.ts",
    "test:watch": "bun test --watch",
    "typecheck": "adamantite check",
    "version": "changeset version && bun run format"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "@types/bun": "1.3.8",
    "adamantite": "0.34.3",
    "bunup": "0.16.21",
    "knip": "6.32.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.14"
}
